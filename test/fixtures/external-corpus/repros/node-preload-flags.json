{
  "reproVersion": 1,
  "family": "node-preload-flags",
  "status": "SELECTED for future Step 114; not implemented; Step 102 acceptance required",
  "authorship": "Authored minimal controls; no upstream source copied. Script strings are never executed. Baseline arrays follow documented current command recognition; afterF1 arrays are proposed acceptance, not passing tests or shipped behavior.",
  "grammar": {
    "command": "exact dequoted node after existing supported leading assignments",
    "flags": [
      "-r MODULE",
      "--require MODULE",
      "--require=MODULE",
      "--import MODULE",
      "--import=MODULE"
    ],
    "passThroughFlags": ["--test"],
    "stop": "First non-option operand or --; do not inspect subsequent arguments.",
    "rejectNewPreloads": "Unknown/malformed option prefix, eval/print/loader/compact flags or existing unsupported shell region. Preserve ordinary outer command credit; opaque shell segments preserve their ordinary no-credit rule.",
    "module": "Use existing package-specifier classifier, normalize recognized external subpaths, no executable mapping or installed resolution. Existing dependency/devDependency gate only; no missing from scripts."
  },
  "evidenceProposal": {
    "kind": "script",
    "via": "node-preload",
    "file": "package.json",
    "pointer": "/scripts/check",
    "command": "Exact dequoted preload module selector (e.g. @sample/preload/esm), excluding the option prefix.",
    "occurrence": "Ordinal among accepted external candidate events over the entire script, before declaration, deduplication or exclusion filtering. Outer node and first eligible preload are 0 and 1 only when no earlier accepted events exist. For eslint . && node -r preload-alpha they are eslint=0, node=1, preload-alpha=2; an earlier undeclared command also consumes its ordinal. Internal/builtin/unsupported module values produce no external event. No source offsets are invented.",
    "step102Amendments": [
      "EVIDENCE_CONTRACT script via enum/command/occurrence/sort rank",
      "CLI_AND_JSON_CONTRACT script via description",
      "report-v1.schema.json script via enum; add conformance examples/controls"
    ]
  },
