{
  "name": "composed-aliases-and-collisions",
  "version": "1.0.0",
  "dependencies": {
    "@angular/cli": "^1.0.0",
    "@babel/cli": "^7.0.0",
    "@graphql-codegen/cli": "^5.0.0",
    "dotenv-cli": "^7.0.0",
    "npm-run-all": "^4.0.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "gulp": "^4.0.0",
    "gulp-cli": "^3.0.0",
    "playwright": "^1.44.0",
    "tailwindcss": "^3.4.0",
    "unused-tool": "^1.0.0",
    "vite": "^5.0.0",
    "vitest": "^2.0.0",
    "webpack": "^5.90.0"
  },
  "scripts": {
    "ng": "ng build",
    "transpile": "babel src -d dist",
    "codegen": "graphql-codegen --config codegen.ts && graphql-codegen-esm init",
    "ci": "run-p lint test",
    "dev": "dotenv -e .env -- node app.js",
    "tasks": "gulp build",
    "bundle": "webpack --mode production",
    "styles": "tailwindcss -i src/input.css -o dist/out.css",
    "e2e": "playwright test",
    "lint": "eslint . && vite build && vitest run",
    "misleading": "echo ng && node -e \"ng babel\" && printf 'webpack\\n'",
    "unknown": "totally-unknown-tool --json"
  }
}
