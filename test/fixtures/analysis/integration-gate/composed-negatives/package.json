{
  "name": "gate-composed-negatives",
  "version": "0.0.0",
  "dependencies": {
    "eslint-config-prettier": "9.0.0",
    "eslint-plugin-react": "7.0.0",
    "jest-environment-jsdom": "29.0.0",
    "react": "18.0.0",
    "ts-jest": "29.0.0",
    "zod": "3.0.0"
  },
  "devDependencies": {
    "docsify-cli": "4.0.0",
    "eslint": "9.0.0",
    "jest": "29.0.0",
    "typescript": "5.0.0"
  },
  "peerDependencies": {
    "react-dom": "18.0.0"
  },
  "optionalDependencies": {
    "fsevents": "2.0.0"
  },
  "scripts": {
    "build": "echo tsc",
    "docs": "printf '%s' docsify",
    "docs2": "env VAR=docsify other-tool",
    "lint": "node -e \"console.log('eslint')\"",
    "test": "node ./run-jest.js --preset ts-jest --env jest-environment-jsdom"
  },
  "eslintConfig": {
    "extends": ["plugin:other/recommended", "ts-jest", "eslint:recommended"],
    "plugins": ["@scope/eslint-plugin", "ts-jest"],
    "settings": {
      "jest": "ts-jest",
      "react": "react"
    },
    "prettier": true
  },
  "jest": {
    "displayName": "ts-jest",
    "preset": "local-preset",
    "testEnvironment": "jsdom",
    "transform": {
      "ts-jest": "babel-jest"
    },
    "setupFiles": ["jest-environment-jsdom", "eslint-config-prettier"]
  }
}
