{
  "name": "depvitals",
  "version": "0.0.0",
  "description": "A simple, lightweight dependency health checker for Node.js projects.",
  "keywords": [
    "dependencies",
    "dependency",
    "health",
    "checker",
    "unused",
    "missing",
    "package.json",
    "cli"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.28.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MatiasRicardi/depvitals.git"
  },
  "bugs": {
    "url": "https://github.com/MatiasRicardi/depvitals/issues"
  },
  "homepage": "https://github.com/MatiasRicardi/depvitals#readme",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist',{ recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "prepublishOnly": "pnpm run check && pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
