{
  "schemaVersion": 1,
  "tool": {
    "name": "depvitals",
    "version": "0.4.0"
  },
  "mode": "explain",
  "project": {
    "root": "/example/project"
  },
  "scope": {
    "sourceExtensions": [".cjs", ".cts", ".js", ".jsx", ".mjs", ".mts", ".ts", ".tsx"],
    "excludedDirectories": [
