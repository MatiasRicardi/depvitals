      ".git",
      ".next",
      ".nuxt",
      ".turbo",
      "build",
      "coverage",
      "dist",
      "node_modules",
      "out"
    ],
    "ignorePaths": [],
    "ignoreDependencies": ["unused"]
  },
  "findings": {
    "unusedDependencies": [],
    "unusedDevDependencies": [],
    "missingDependencies": []
  },
  "counts": {
    "unusedDependencies": 0,
    "unusedDevDependencies": 0,
    "missingDependencies": 0
  },
  "packages": [
    {
      "name": "unused",
      "status": "excluded",
      "declaredIn": ["dependencies"],
      "excluded": true,
      "underlyingFindings": ["unusedDependencies"],
      "findings": [],
      "evidence": []
    }
  ],
  "query": {
    "packageName": "unused",
    "known": true
  }
