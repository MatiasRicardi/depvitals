{
  "schemaVersion": 1,
  "tool": {
    "name": "depvitals",
    "version": "0.5.0"
  },
  "mode": "scan",
  "project": {
    "root": "/example/project"
  },
  "scope": {
    "sourceExtensions": [".cjs", ".cts", ".js", ".jsx", ".mjs", ".mts", ".ts", ".tsx"],
    "excludedDirectories": [
      ".cache",
      ".git",
      ".next",
      ".nuxt",
      ".turbo",
      "build",
      "coverage",
      "dist",
      "node_modules",
      "out"
    ],
    "ignorePaths": [],
    "ignoreDependencies": []
  },
  "findings": {
    "unusedDependencies": [],
    "unusedDevDependencies": [],
    "missingDependencies": []
  },
  "counts": {
    "unusedDependencies": 0,
    "unusedDevDependencies": 0,
    "missingDependencies": 0
  },
  "packages": [],
  "query": null,
  "diagnostics": {
    "sourceFilesScanned": 0,
    "nestedPackageSourceFiles": 0,
    "notices": ["no-supported-sources", "workspace-declared"]
  }
}
